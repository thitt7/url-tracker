{
  email {$CADDY_EMAIL}
}

# Primary domain
url-tracker.com {
  encode gzip

  handle /api/* {
    reverse_proxy dotnet:{$DOTNET_PORT}
  }

  reverse_proxy next:{$NEXT_SERVER_PORT}
}

# Staging subdomain
staging.url-tracker.com {
  encode gzip

  handle /api/* {
    reverse_proxy dotnet:{$DOTNET_PORT}
  }

  reverse_proxy next:{$NEXT_SERVER_PORT}
}

# Redirect www → root
www.url-tracker.com {
  redir https://url-tracker.com{uri}
}