{
  email {env.CADDY_EMAIL}
}

{env.STAGING_DOMAIN} {
  encode gzip

  # Route API traffic to the .NET container (ports from .env.vps: DOTNET_PORT, NEXT_SERVER_PORT).
  handle /api/* {
    reverse_proxy dotnet:{env.DOTNET_PORT}
  }

  # Everything else goes to Next.js.
  reverse_proxy next:{env.NEXT_SERVER_PORT}
}

