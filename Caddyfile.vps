{
  email {$CADDY_EMAIL}
}

{$DOMAIN:staging.url-tracker.com} {
  encode gzip

  # Route API traffic to the .NET container (ports from .env.vps: DOTNET_PORT, NEXT_SERVER_PORT).
  handle /api/* {
    reverse_proxy dotnet:{$DOTNET_PORT}
  }

  # Everything else goes to Next.js.
  reverse_proxy next:{$NEXT_SERVER_PORT}
}